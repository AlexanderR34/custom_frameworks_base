<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_island_popup_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/music_island_popup_bg"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:elevation="12dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Previous Track Button -->
    <ImageView
        android:id="@+id/music_island_btn_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:src="@drawable/ic_music_island_prev"
        android:background="@drawable/music_island_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Previous Track" />

    <Space
        android:layout_width="8dp"
        android:layout_height="match_parent" />

    <!-- Play/Pause Toggle Button -->
    <ImageView
        android:id="@+id/music_island_btn_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_music_island_pause"
        android:background="@drawable/music_island_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Play/Pause" />

    <Space
        android:layout_width="8dp"
        android:layout_height="match_parent" />

    <!-- Next Track Button -->
    <ImageView
        android:id="@+id/music_island_btn_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:src="@drawable/ic_music_island_next"
        android:background="@drawable/music_island_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Next Track" />

</LinearLayout>
