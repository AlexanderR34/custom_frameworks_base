<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dynamic_island_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp">

    <!-- 1. Media Section -->
    <LinearLayout
        android:id="@+id/card_media_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded Album Art with volume badge -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/card_media_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/card_media_volume_badge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_volume_media"
                    android:tint="#FFFFFF"
                    android:background="@drawable/music_island_volume_badge_bg"
                    android:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_media_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever" />

                <TextView
                    android:id="@+id/card_media_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textColor="#A0FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/card_media_output_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_cast"
                android:tint="#D0FFFFFF" />

            <com.android.systemui.statusbar.phone.island.WaveformView
                android:id="@+id/card_media_waveform"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Playback controls row (Middle) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/card_media_btn_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:src="@drawable/ic_music_island_prev"
                android:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <Space
                android:layout_width="56dp"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/card_media_btn_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="4dp"
                android:src="@drawable/ic_music_island_play"
                android:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <Space
                android:layout_width="56dp"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/card_media_btn_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:src="@drawable/ic_music_island_next"
                android:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Progress bar row (Bottom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/card_media_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#B3FFFFFF"
                android:text="00:00" />

            <ProgressBar
                android:id="@+id/card_media_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:progressDrawable="@drawable/dynamic_island_media_progress"
                android:progress="0"
                android:max="10000" />

            <TextView
                android:id="@+id/card_media_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#B3FFFFFF"
                android:text="00:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Call Section -->
    <LinearLayout
        android:id="@+id/card_call_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/card_call_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:padding="6dp"
                android:background="@drawable/music_island_btn_bg"
                android:tint="#00E676" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/card_call_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/card_call_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/island_call_in_progress"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#81C784" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <ImageView
                android:id="@+id/card_call_btn_mute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/vd_mic"
                android:background="@drawable/music_island_btn_bg"
                android:clickable="true"
                android:focusable="true" />

            <Space
                android:layout_width="36dp"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/card_call_btn_hangup"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="10dp"
                android:src="@drawable/ic_call_end"
                android:tint="#FF5252"
                android:background="@drawable/music_island_btn_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Timer Section -->
    <LinearLayout
        android:id="@+id/card_timer_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_timelapse"
                android:padding="4dp"
                android:tint="#FFA726" />

            <TextView
                android:id="@+id/card_timer_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/island_timer"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/card_timer_digits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFA726"
                android:text="00:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/card_timer_btn_reset"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/music_island_btn_bg"
                android:clickable="true"
                android:focusable="true" />

            <Space
                android:layout_width="28dp"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/card_timer_btn_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_music_island_pause"
                android:background="@drawable/music_island_btn_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Charging Section (HyperCharge 90W Ultra) -->
    <LinearLayout
        android:id="@+id/card_charging_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_bolt_charging"
                android:tint="#00E676" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/card_charging_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/island_charging_hypercharge"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/card_charging_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90.0W Turbo"
                    android:textSize="12sp"
                    android:textColor="#00E676" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_charging_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="85%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/card_charging_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:progress="85"
            android:max="100" />
    </LinearLayout>

    <!-- 5. Screen Record Section -->
    <LinearLayout
        android:id="@+id/card_record_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/card_record_dot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_recording_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_screen_recording"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/card_record_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FF8A80"
                android:text="00:00" />
        </LinearLayout>

        <ImageView
            android:id="@+id/card_record_btn_stop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_timer_island_stop"
            android:tint="#FF5252"
            android:background="@drawable/music_island_btn_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 6. Transient Banner Section (Bluetooth, Ringer, DND) -->
    <LinearLayout
        android:id="@+id/card_banner_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/card_banner_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/card_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true" />

            <TextView
                android:id="@+id/card_banner_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#B0BEC5"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_banner_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 7. Navigation Section (Google Maps / GPS live turn-by-turn) -->
    <LinearLayout
        android:id="@+id/card_nav_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/card_nav_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:src="@drawable/ic_location"
                android:tint="#38BDF8"
                android:background="@drawable/music_island_btn_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/card_nav_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/card_nav_instruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/card_nav_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="11.5sp"
            android:textColor="#94A3B8"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 8. Download Section (File downloads with speed & progress) -->
    <LinearLayout
        android:id="@+id/card_download_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_download_for_offline"
                android:tint="#00E676" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/card_download_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/card_download_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#00E676"
                    android:singleLine="true" />
            </LinearLayout>

            <ImageView
                android:id="@+id/card_download_btn_cancel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="#FF5252"
                android:background="@drawable/music_island_btn_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/card_download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00E676" />

        <TextView
            android:id="@+id/card_download_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="10.5sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- 9. Torch / Flashlight Section -->
    <LinearLayout
        android:id="@+id/card_torch_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_flashlight"
            android:tint="#FFFFFF"
            android:background="@drawable/music_island_btn_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_torch_on"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_torch_tap_off"
                android:textSize="11sp"
                android:textColor="#B0FFFFFF" />
        </LinearLayout>

        <ImageView
            android:id="@+id/card_torch_btn_toggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_timer_island_stop"
            android:tint="#FFFFFF"
            android:background="@drawable/music_island_btn_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 10. Hotspot / Zona Wi-Fi Section -->
    <LinearLayout
        android:id="@+id/card_hotspot_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_hotspot"
            android:tint="#38BDF8"
            android:background="@drawable/music_island_btn_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_hotspot"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/card_hotspot_devices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_hotspot_devices_none"
                android:textSize="11sp"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <ImageView
            android:id="@+id/card_hotspot_btn_toggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_timer_island_stop"
            android:tint="#38BDF8"
            android:background="@drawable/music_island_btn_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 11. Cast / Pantalla Inalámbrica Section -->
    <LinearLayout
        android:id="@+id/card_cast_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_cast"
            android:tint="#38BDF8"
            android:background="@drawable/music_island_btn_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_casting_screen"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />

            <TextView
                android:id="@+id/card_cast_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_wireless_display"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/card_cast_btn_disconnect"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="#FF5252"
            android:background="@drawable/music_island_btn_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 12. Privacy Sensor Indicators Section (Camera / Mic / Location) -->
    <LinearLayout
        android:id="@+id/card_privacy_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/card_privacy_icons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/card_privacy_icon_cam"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_camera"
                android:tint="#00E676"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/card_privacy_icon_mic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/vd_mic"
                android:tint="#FF9100"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/card_privacy_icon_location"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location"
                android:tint="#0091EA"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_privacy_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/card_privacy_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#00E676"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 13. Clipboard Copied Text Section -->
    <LinearLayout
        android:id="@+id/card_clipboard_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_content_copy"
            android:tint="#00E5FF"
            android:background="@drawable/music_island_btn_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/island_clipboard_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00E5FF" />

            <TextView
                android:id="@+id/card_clipboard_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
