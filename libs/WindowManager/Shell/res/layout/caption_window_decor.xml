<com.android.wm.shell.windowdecor.WindowDecorLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/caption"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/caption_decor_title">

    <!-- HyperOS Centered Handle Bar -->
    <View
        android:id="@+id/caption_handle"
        android:layout_width="44dp"
        android:layout_height="4.5dp"
        android:background="@drawable/decor_handle_dark"
        android:alpha="0.8" />

    <!-- Retained for backward-compatible View binding without crashing -->
    <ImageView
        android:id="@+id/application_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/application_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        style="@style/CaptionButtonStyle"
        android:id="@+id/pin_window"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        style="@style/CaptionButtonStyle"
        android:id="@+id/maximize_window"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        style="@style/CaptionButtonStyle"
        android:id="@+id/close_window"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</com.android.wm.shell.windowdecor.WindowDecorLinearLayout>